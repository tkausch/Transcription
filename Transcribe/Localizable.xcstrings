    "Download the Whisper model once to enable transcriptions. No data ever leaves your device." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download Whisper-modellen én gang for at aktivere transskriptioner. Ingen data forlader nogensinde din enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade das Whisper-Modell einmalig herunter, um Transkriptionen zu ermöglichen. Es verlassen keine Daten dein Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga el modelo Whisper una vez para habilitar las transcripciones. Ningún dato sale de tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargez le modèle Whisper une seule fois pour activer les transcriptions. Aucune donnée ne quitte votre appareil."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæktu Whisper-líkanið einu sinni til að virkja umritanir. Engin gögn fara af tækinu þínu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last ned Whisper-modellen én gang for å aktivere transkripsjoner. Ingen data forlater enheten din."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladda ner Whisper-modellen en gång för att aktivera transkriptioner. Ingen data lämnar någonsin din enhet."
          }
        }
      }
    },
