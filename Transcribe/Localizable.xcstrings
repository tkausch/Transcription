    "Keep the app open and in the foreground while the model is downloading. Sending the app to the background or closing it may interrupt the download." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold appen åben og i forgrunden mens modellen downloades. At sende appen til baggrunden eller lukke den kan afbryde downloaden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass die App geöffnet und im Vordergrund, während das Modell heruntergeladen wird. Das Minimieren oder Schließen der App kann den Download unterbrechen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la app abierta y en primer plano mientras se descarga el modelo. Enviarla al fondo o cerrarla puede interrumpir la descarga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez l'application ouverte et au premier plan pendant le téléchargement du modèle. Envoyer l'application en arrière-plan ou la fermer peut interrompre le téléchargement."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haltu forritinu opnu og í forgrunni meðan líkanið er sótt. Að senda forritið í bakgrunn eða loka því getur truflað niðurhalið."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold appen åpen og i forgrunnen mens modellen lastes ned. Å sende appen til bakgrunnen eller lukke den kan avbryte nedlastingen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll appen öppen och i förgrunden medan modellen laddas ner. Att skicka appen till bakgrunden eller stänga den kan avbryta nedladdningen."
          }
        }
      }
    },
