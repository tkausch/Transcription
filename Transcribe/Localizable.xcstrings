    "Supports MP3, M4A, WAV, and MP4 files from anywhere on your device. Spoken language is detected automatically — no configuration needed." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Understøtter MP3-, M4A-, WAV- og MP4-filer fra overalt på din enhed. Det talte sprog registreres automatisk — ingen konfiguration nødvendig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterstützt MP3-, M4A-, WAV- und MP4-Dateien von überall auf deinem Gerät. Die gesprochene Sprache wird automatisch erkannt — keine Konfiguration erforderlich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compatible con archivos MP3, M4A, WAV y MP4 de cualquier lugar de tu dispositivo. El idioma hablado se detecta automáticamente — sin configuración necesaria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prend en charge les fichiers MP3, M4A, WAV et MP4 depuis n'importe où sur votre appareil. La langue parlée est détectée automatiquement — aucune configuration nécessaire."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styður MP3-, M4A-, WAV- og MP4-skrár hvaðanæva af tækinu þínu. Talið tungumál greinist sjálfkrafa — engin stilling þarf."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Støtter MP3-, M4A-, WAV- og MP4-filer fra hvor som helst på enheten din. Talt språk oppdages automatisk — ingen konfigurasjon nødvendig."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stöder MP3-, M4A-, WAV- och MP4-filer från var som helst på din enhet. Talat språk identifieras automatiskt — ingen konfiguration behövs."
          }
        }
      }
    },
    "Tap ✦ to generate a summary." : {
